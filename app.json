{
  "appid": "password-manager",
  "name": "Password Manager",
  "description": "Gerenciador de senhas minimalista e seguro para CasaOS. Criptografia AES-256, autenticação JWT e backup automático.",
  "icon": "https://cdn-icons-png.flaticon.com/512/3050/3050159.png",
  "version": "1.0.0",
  "author": "Lucca Avena",
  "category": "Utilities",
  "website": "https://github.com/Lucca-png/Password-Manager-For-CasaOS",
  "source": "https://github.com/Lucca-png/Password-Manager-For-CasaOS",
  "container_name": "password-manager",
  "image": "password-manager:latest",
  "scheme": "http",
  "host": "localhost",
  "port": 3000,
  "protocol": "http",
  "store_app_id": "password-manager",
  "tag": "password-manager",
  "docker_compose": "docker-compose.yml",
  "volumes": [
    {
      "source": "/data/password-manager",
      "destination": "/app/data",
      "mode": "rw"
    }
  ],
  "ports": [
    {
      "container": 3000,
      "host": 3000,
      "protocol": "tcp",
      "description": "Frontend Port"
    },
    {
      "container": 8000,
      "host": 8000,
      "protocol": "tcp",
      "description": "Backend API Port"
    }
  ],
  "environment": [
    {
      "key": "SECRET_KEY",
      "description": "Secret key for JWT tokens",
      "default": "change-this-secret-key-in-production"
    },
    {
      "key": "DATABASE_URL",
      "description": "Database URL",
      "default": "sqlite:///./data/vault.db"
    },
    {
      "key": "BACKEND_PORT",
      "description": "Backend API port",
      "default": "8000"
    },
    {
      "key": "FRONTEND_PORT",
      "description": "Frontend port",
      "default": "3000"
    }
  ],
  "restart_policy": "always",
  "privileged": false,
  "network_mode": "bridge",
  "hostname": "password-manager",
  "cap_add": [],
  "cap_drop": [],
  "devices": [],
  "sysctls": {},
  "labels": {
    "icon": "password-manager"
  },
  "web_ui": {
    "container_port": 3000,
    "public": true
  },
  "health_check": {
    "test": ["CMD", "curl", "-f", "http://localhost:8000/docs"],
    "interval": 30,
    "timeout": 10,
    "retries": 3,
    "start_period": 40
  }
}
